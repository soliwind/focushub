rules_version = '2';

// Firestore 보안 규칙. Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여 넣고 "게시"한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.memberUids;
    }

    function isOwner(groupId) {
      return signedIn() && get(groupPath(groupId)).data.ownerUid == request.auth.uid;
    }

    // 초대 링크의 코드를 알고 있는지. 가입 문서에 적어 보낸 코드를 그룹의 코드와 비교한다.
    function hasInviteCode(groupId) {
      return request.resource.data.inviteCode == get(groupPath(groupId)).data.inviteCode;
    }

    // 내 정보와 설정: 나만 읽고 쓴다.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 프로필(사진, 소개): 그룹 구성원에게 보여야 해서 로그인한 사람은 읽을 수 있다. 쓰기는 본인만.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photo', 'bio'])
        && request.resource.data.photo.size() < 100000
        && request.resource.data.bio.size() <= 60;
    }

    // 공부 세션: 내 세션만 읽고 쓴다. 다른 사람 것으로 바꿔 저장할 수 없다. 지우지는 않는다.
    match /sessions/{sessionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // 계정·기록 삭제 요청: 본인 것만 접수하고 본다. 처리는 관리자가 콘솔에서 한다.
    match /deletionRequests/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // 스터디그룹
    // get(문서 하나 읽기)은 로그인한 사람 모두 허용: 초대 링크로 그룹 이름을 보여 주려면 필요하다.
    // list(목록 조회)는 내가 구성원인 그룹만.
    match /groups/{groupId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow delete: if false;

      // 운영자는 그룹 정보를 바꿀 수 있다. 구성원 스스로는 memberUids에서 자기 자신만 더하거나 뺄 수 있다.
      allow update: if isOwnerOf(resource.data) || isSelfJoin() || isSelfLeave();

      function isOwnerOf(group) {
        return signedIn() && group.ownerUid == request.auth.uid;
      }

      function onlyMemberUidsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']);
      }

      function isSelfJoin() {
        return signedIn()
          && onlyMemberUidsChanged()
          && resource.data.joinMode == 'open'
          && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
          && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 0
          && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.inviteCode == resource.data.inviteCode;
      }

      function isSelfLeave() {
        return signedIn()
          && onlyMemberUidsChanged()
          && resource.data.ownerUid != request.auth.uid
          && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
          && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0;
      }

      // 구성원: 그룹 구성원만 읽는다.
      match /members/{uid} {
        allow read: if isMember(groupId);
        // 운영자(그룹을 만드는 순간 포함)는 구성원을 등록할 수 있다.
        allow create, update: if signedIn() && getAfter(groupPath(groupId)).data.ownerUid == request.auth.uid;
        // 즉시 가입 그룹에는 초대 코드를 가진 본인이 직접 들어온다.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && get(groupPath(groupId)).data.joinMode == 'open'
          && hasInviteCode(groupId)
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'active';
        // 탈퇴는 본인이 상태만 바꾼다.
        allow update: if signedIn()
          && request.auth.uid == uid
          && resource.data.role == 'member'
          && request.resource.data.status == 'left'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'leftAt']);
        allow delete: if false;
      }

      // 가입 요청: 운영자와 요청한 본인만 본다.
      match /joinRequests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(groupId));
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.status == 'pending'
          && hasInviteCode(groupId);
        // 거절됐거나 탈퇴했던 사람은 다시 요청할 수 있다.
        allow update: if signedIn()
          && request.auth.uid == uid
          && resource.data.status != 'pending'
          && request.resource.data.status == 'pending'
          && hasInviteCode(groupId);
        // 대기 중인 요청만 운영자가 처리한다.
        allow update: if isOwner(groupId) && resource.data.status == 'pending';
        allow delete: if false;
      }

      // 지금 상태 표시판: 구성원만 읽고, 본인 것만 쓴다. 공부 상태와 시간만 들어 있다.
      match /presence/{uid} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId)
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
      }

      // 그룹 집계: 구성원만 읽고, 본인 세션만 더한다. 문서 ID가 세션 ID라 같은 세션은 두 번 더해지지 않는다.
      match /contributions/{sessionId} {
        allow read: if isMember(groupId);
        allow create, update: if isMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sessionId == sessionId
          && (resource == null || resource.data.uid == request.auth.uid);
        allow delete: if false;
      }
    }
  }
}
